config global 'main'
	option enabled '0'
	option singbox_bin '/usr/bin/sing-box'
	option active_profile 'default'
	option auto_start '1'
	option auto_rollback '1'
	option log_level 'info'
	option cache_file '/tmp/singsing/cache.db'
	option ruleset_dir '/etc/sing-box/rule-sets'
	option ruleset_download_prefix ''
	option tailscale_state_root '/etc/sing-box/tailscale'

config dns 'dns'
	option local_type 'udp'
	option local_server ''
	option local_port '53'
	option local_server_name ''
	option local_path '/dns-query'
	option listen_address '127.0.0.1'
	option listen_port '5335'
	option hijack '1'
	option dnsmasq_manage '1'

config tun 'tun'
	option enabled '1'
	option interface_name 'singtun'
	option address_v4 '172.19.0.1/30'
	option address_v6 'fdfe:dcba:9876::1/126'
	option auto_route '1'
	option auto_redirect '1'
	option strict_route '1'
	option ipv6 '1'
	option mtu ''
	option route_exclude_address ''

config subscription 'subscription'
	option auto_update '0'
	option update_interval '86400'
	option auto_apply '1'
