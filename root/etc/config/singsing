config global 'main'
	option enabled '0'
	option singbox_bin '/usr/bin/sing-box'
	option active_profile 'default'
	option auto_start '1'
	option auto_rollback '1'
	option log_level 'info'
	option cache_file '/tmp/singsing/cache.db'
	option ruleset_dir '/etc/sing-box/rule-sets'
	option ruleset_download_prefix ''
	option ruleset_auto_update '0'
	option ruleset_update_cron '0 4 * * *'
	option tailscale_state_root '/etc/sing-box/tailscale'

config dns 'dns'
	option local_type 'udp'
	option local_server ''
	option local_port '53'
	option local_server_name ''
	option local_path '/dns-query'
	option local_bootstrap ''
	option local_backup_server ''
	option listen_address '127.0.0.1'
	option listen_port '5335'
	option hijack '1'
	option dnsmasq_manage '1'
	option allow_proxy_ipv6 '0'

config tun 'tun'
	option enabled '1'
	option interface_name 'singtun'
	option address_v4 '172.19.0.1/30'
	option address_v6 'fdfe:dcba:9876::1/126'
	option auto_route '1'
	option auto_redirect '1'
	option strict_route '0'
	option ipv6 '1'
	option ipv6_mode 'direct'
	option mtu '9000'
	option udp_timeout ''
	option route_exclude_address ''
	option route_exclude_cn '0'
	option include_interface ''
	option default_interface ''

config mixed 'mixed'
	option enabled '0'
	option listen_address '::'
	option listen_port '5330'

config routing 'routing'
	option bypass_cn '1'
	option cn_site_ruleset 'geosite-cn'
	option port_mode 'all'
	option custom_ports ''
	option block_quic '0'
