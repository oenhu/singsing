#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG_MGR="/usr/share/singsing/service-manager.sh"
SB_CONFIG="/etc/singsing/sing-box.json"

boot() {
	local auto_start
	config_load singsing
	config_get auto_start main auto_start "1"
	[ "$auto_start" = "1" ] || return 0
	start "$@"
}

start_service() {
	local enabled bin

	config_load singsing
	config_get enabled main enabled "0"
	config_get bin main singbox_bin "/usr/bin/sing-box"

	if [ "$enabled" != "1" ]; then
		"$PROG_MGR" dnsmasq_restore
		"$PROG_MGR" cron_remove >/dev/null 2>&1 || true
		return 0
	fi

	if ! "$PROG_MGR" check_local_dns; then
		logger -t singsing -p daemon.err "Refusing to start: direct upstream DNS configuration is missing or invalid"
		"$PROG_MGR" dnsmasq_restore
		return 1
	fi

	if [ ! -x "$bin" ]; then
		logger -t singsing -p daemon.err "Refusing to start: sing-box binary not found at $bin"
		"$PROG_MGR" dnsmasq_restore
		return 1
	fi

	if [ ! -s "$SB_CONFIG" ]; then
		logger -t singsing -p daemon.err "Refusing to start: config file $SB_CONFIG does not exist"
		"$PROG_MGR" dnsmasq_restore
		return 1
	fi

	"$PROG_MGR" ensure_dirs
	"$PROG_MGR" disable_stock_singbox >/dev/null 2>&1 || true

	if [ "${SINGSING_FROM_APPLY:-0}" != "1" ]; then
		# Auto-download missing local rule-sets on boot/manual start
		if ! "$PROG_MGR" ensure_rulesets; then
			logger -t singsing -p daemon.err "Failed to ensure local rule-sets; aborting start"
			"$PROG_MGR" dnsmasq_restore
			return 1
		fi

		# Validate before launching
		if ! "$bin" check -c "$SB_CONFIG" >/dev/null 2>&1; then
			logger -t singsing -p daemon.err "Config validation failed for $SB_CONFIG; aborting start"
			"$PROG_MGR" dnsmasq_restore
			return 1
		fi
	fi

	procd_open_instance "singsing"
	procd_set_param command "$bin" run -c "$SB_CONFIG"
	# QUIC-GO GSO is broken on Linux 6.6 (OpenWrt 24.10)
	uname -r | grep -Eq '^6\.6' && procd_set_param env QUIC_GO_DISABLE_GSO=true
	[ -f "/etc/capabilities/singsing.json" ] && \
		procd_set_param capabilities "/etc/capabilities/singsing.json"
	procd_set_param respawn 3600 5 5
	procd_set_param no_new_privs 1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="unlimited" nofile="1000000 1000000"
	procd_set_param file "$SB_CONFIG"
	procd_close_instance

	"$PROG_MGR" cron_sync >/dev/null 2>&1 || true
}

service_started() {
	[ "${SINGSING_FROM_APPLY:-0}" = "1" ] && return 0

	local enabled
	config_load singsing
	config_get enabled main enabled "0"
	if [ "$enabled" != "1" ]; then
		"$PROG_MGR" dnsmasq_restore
		return 0
	fi

	if "$PROG_MGR" wait_dns_ready 10; then
		"$PROG_MGR" dnsmasq_takeover
	else
		logger -t singsing -p daemon.err "sing-box DNS did not become ready in time; skipping dnsmasq takeover"
		"$PROG_MGR" dnsmasq_restore
	fi
}

stop_service() {
	"$PROG_MGR" dnsmasq_restore
	"$PROG_MGR" cron_remove >/dev/null 2>&1 || true
}

service_stopped() {
	"$PROG_MGR" dnsmasq_restore
}

reload_service() {
	stop
	start
}
