#!/bin/sh

/usr/share/singsing/service-manager.sh ensure_dirs
/usr/share/singsing/service-manager.sh disable_stock_singbox >/dev/null 2>&1 || true

# Ensure new UCI sections exist on upgrade without overwriting user choices
if [ -f /etc/config/singsing ]; then
	uci -q get singsing.mixed >/dev/null 2>&1 || {
		uci -q set singsing.mixed='mixed'
		uci -q set singsing.mixed.enabled='0'
		uci -q set singsing.mixed.listen_address='::'
		uci -q set singsing.mixed.listen_port='5330'
	}
	uci -q get singsing.routing >/dev/null 2>&1 || {
		uci -q set singsing.routing='routing'
		uci -q set singsing.routing.bypass_cn='1'
		uci -q set singsing.routing.cn_site_ruleset='geosite-cn'
		uci -q set singsing.routing.port_mode='all'
		uci -q set singsing.routing.custom_ports=''
		uci -q set singsing.routing.block_quic='0'
	}
	uci -q commit singsing 2>/dev/null || true
fi

# Migrate existing singsing-generated config from legacy path if present
if [ ! -s /etc/singsing/sing-box.json ] && [ -s /etc/sing-box/config.json ]; then
	if grep -q '"dns-in"' /etc/sing-box/config.json 2>/dev/null; then
		cp -f /etc/sing-box/config.json /etc/singsing/sing-box.json
		chmod 600 /etc/singsing/sing-box.json 2>/dev/null || true
	fi
fi

# Clean up legacy subscription cron entry if upgrading from an older release
if [ -f /etc/crontabs/root ] && grep -q '# singsing-sub' /etc/crontabs/root 2>/dev/null; then
	tmp_cron="$(mktemp /etc/crontabs/.singsing-clean.XXXXXX 2>/dev/null)" || tmp_cron=""
	if [ -n "$tmp_cron" ]; then
		grep -v '# singsing-sub' /etc/crontabs/root > "$tmp_cron" 2>/dev/null || : > "$tmp_cron"
		chmod 600 "$tmp_cron" 2>/dev/null || true
		mv -f "$tmp_cron" /etc/crontabs/root
		printf '%s\n' 'root' >> /etc/crontabs/cron.update 2>/dev/null || true
	fi
fi

/etc/init.d/singsing enable >/dev/null 2>&1 || true
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache/*

exit 0
